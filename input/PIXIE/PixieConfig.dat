% PixieConfig.dat - Pixie-16 / DDAS (LANA + VETO wall). Raw + mapped only, no calibration.
% Same format as FROGConfig.dat. Paths are relative to the project directory.

[readout]
SOURCE_ID             6			% event-builder source ID(s) of the DDAS crate (repeat the key for more)
WRITE_TRACES          1			% 1 = store fTrace in NWB. NWA. VETO. (large)
KEEP_PIXIE_ONLY       1			% 1 = write events where only NWB/NWA/VETO fired (no FROG pass, no HiRA)

[geometry]
CHANNEL_MAP           input/PIXIE/Pixie_ChannelMapping.txt	% Module Channel Wall(B/A/V) Bar Side(L/R, T/B) Index
FIRST_SLOT            2			% crate slot of Module 0 in the map (module = slot - FIRST_SLOT)
